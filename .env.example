# Server bindings only. Never put secrets in VITE_* variables or committed files.
WINE_API_HOST=127.0.0.1
WINE_API_PORT=5180
WINE_DB_FILE=.local/wine-engine.sqlite
# Required when listening on a public interface; set securely at your host.
# ENGINE_ACCESS_TOKEN=
# Comma-separated exact browser origins allowed to connect remotely.
# WINE_ALLOWED_ORIGINS=https://sta2014.github.io
# Example source credential binding, only if required by an approved feed.
# FLICKINGER_FEED_TOKEN=
# Explicitly bind feed credentials to approved hosts. Names/hosts only, no values:
# WINE_SOURCE_CREDENTIAL_HOSTS={"FLICKINGER_FEED_TOKEN":["approved-feed-host.example"]}
# Optional in-app web research (Brave Search API; separate from Wine-Searcher).
# Set through server/host secret settings; never VITE_* or browser storage.
# BRAVE_SEARCH_API_KEY=
